models/
# pano features, road graph, Z_road context, activations
*.parquet
# basis matrix
*.npy
# autoencoder checkpoint
*.pt
# MRLU units & boundaries (regenerable from the pipeline)
*.geojson
*.log
# SLURM job logs
*.out
# Long-running extraction / training progress markers
*.progress

# Kept under outputs/ (NOT ignored): EXPERIMENT_REPORT.md, figures/*.png,
# unit_statistics.csv, stage_reports/*.json

